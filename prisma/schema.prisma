// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectCategory {
  RESIDENCIAL
  COMERCIAL
  INDUSTRIAL
  RURAL
}

model Project {
  id          String          @id @default(cuid())
  slug        String          @unique
  title       String
  description String
  city        String
  state       String          @default("MG")
  category    ProjectCategory
  powerKwp    Float?
  featured    Boolean         @default(false)
  order       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  photos      ProjectPhoto[]
}

model ProjectPhoto {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id             String   @id @default(cuid())
  authorName     String
  authorLocation String?
  text           String
  rating         Int      @default(5)
  photoUrl       String?
  featured       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
}

model Lead {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?
  city       String?
  billAmount String?
  /** ONGRID | HIBRIDO | INDEFINIDO — o que a pessoa marcou no formulário. */
  systemType String?
  message    String?
  createdAt  DateTime @default(now())
}

model SiteSettings {
  id             String   @id @default("singleton")
  whatsappNumber String   @default("")

  // Amostra de um financiamento real. A taxa efetiva da calculadora é
  // derivada destes três valores, e não digitada — o banco anuncia uma
  // taxa menor do que a que sai depois de IOF, tarifas e seguro.
  financingAmount      Float?
  financingInstallment Float?
  financingTerm        Int?
  // Margem somada à taxa apurada, em pontos percentuais. Existe para o
  // site prometer uma parcela um pouco pior que a real: é melhor
  // surpreender pra baixo na proposta do que ter que justificar alta.
  financingMarginPp    Float     @default(0.25)
  financingUpdatedAt   DateTime?

  updatedAt      DateTime @updatedAt
}

/// Cidades oferecidas no seletor da calculadora, com a irradiação local.
/// Listar uma cidade aqui equivale a anunciar atendimento nela.
model City {
  id        String   @id @default(cuid())
  name      String
  state     String   @default("MG")
  /// Irradiação média diária (HSP) em kWh/m²/dia.
  hsp       Float
  latitude  Float
  longitude Float
  /// Fonte do HSP, para o dado ser auditável.
  source    String   @default("NASA POWER (climatologia 2001-2020)")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, state])
}

model HeroPhoto {
  id        String   @id @default(cuid())
  url       String
  caption   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Video {
  id         String   @id @default(cuid())
  title      String
  youtubeId  String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}
