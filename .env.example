# Banco de dados Postgres (Neon, Prisma Postgres, Supabase, etc.)
DATABASE_URL=""

# Autenticação do admin (usuário único)
ADMIN_EMAIL="admin@sumart.com.br"
# Gerar com: node -e "console.log(require('bcryptjs').hashSync('SUA_SENHA_AQUI', 10))"
# IMPORTANTE: o hash gerado contém "$" — escape cada "$" como "\$" neste arquivo,
# senão o Next.js tenta interpretá-los como referência a outra variável.
ADMIN_PASSWORD_HASH=""
# String aleatória longa e secreta (ex: openssl rand -hex 32)
SESSION_SECRET=""

# E-mail (Resend) - notificação de novos leads do formulário de contato
RESEND_API_KEY=""
LEAD_NOTIFICATION_EMAIL="contato@sumart.com.br"

# Upload de imagens (Vercel Blob) - criado automaticamente ao conectar um Blob Store no Vercel
BLOB_READ_WRITE_TOKEN=""

# WhatsApp da empresa - usado só como valor inicial na primeira execução.
# Depois disso, o número real fica em /admin/configuracoes (tabela SiteSettings no banco).
NEXT_PUBLIC_WHATSAPP_NUMBER=""
